  "rewrites": [
    {
      "name": "bit_to_boolean",
      "description": "BIT columns are BOOLEAN on Databricks: 0/1 comparisons become FALSE/TRUE and values written into them are cast to BOOLEAN (needs DDL).",
      "procedures": [
        "usp_upsert_patient_enrollment",
        "usp_calc_refill_gaps",
        "usp_classify_payer_claims",
        "usp_shipment_sla_report"
      ]
    },
    {
      "name": "compact_date_literal",
      "description": "'yyyymmdd' strings compared with dates become DATE literals; Spark cannot cast them implicitly (needs DDL).",
      "procedures": [
        "usp_upsert_patient_enrollment"
      ]
    },
    {
      "name": "iso_week_extract",
      "description": "EXTRACT(WEEKISO ...) becomes EXTRACT(WEEK ...), the Databricks ISO 8601 field.",
      "procedures": [
        "usp_shipment_sla_report"
      ]
    },
    {
      "name": "plus_to_concat",
      "description": "String '+' becomes CONCAT; sqlglot leaves '+', which Databricks treats as numeric addition.",
      "procedures": []
    },
    {
      "name": "transient_table_to_cte",
      "description": "Temp tables / table variables populated without later mutation become CTEs (or intermediate models when read more than once).",
      "procedures": [
        "usp_build_monthly_inventory_snapshot",
        "usp_shipment_sla_report"
      ]
    },
    {
      "name": "try_convert_safe_parse",
      "description": "TRY_CONVERT with a style becomes CAST(TRY_TO_TIMESTAMP(...)); sqlglot emits TO_DATE/TO_TIMESTAMP, which raise on bad input.",
      "procedures": [
        "usp_upsert_patient_enrollment"
      ]
    },
    {
      "name": "update_from_to_merge",
      "description": "UPDATE/DELETE ... FROM ... JOIN becomes MERGE INTO, because Delta UPDATE/DELETE has no FROM clause.",
      "procedures": [
        "usp_build_monthly_inventory_snapshot",
        "usp_update_shipment_status"
      ]
    }
  ]
}
